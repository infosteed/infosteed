# Use ghcr to pull official release images, or build to compile this checkout.
IMAGE_SOURCE=ghcr
RELEASE_VERSION=0.1.0-beta.17
RELEASE_COMMIT=REPLACE_WITH_FULL_COMMIT
LOCAL_IMAGE_TAG=sha-REPLACE_WITH_12_CHARACTER_COMMIT
DEPLOY_WAIT_TIMEOUT=300

# Optional full image overrides, including digest-pinned mirrors:
# WEB_IMAGE=registry.example/infosteed-web:0.1.0-beta.17@sha256:...
# API_IMAGE=registry.example/infosteed-api:0.1.0-beta.17@sha256:...
# RENDER_IMAGE=registry.example/infosteed-video-render-worker:0.1.0-beta.17@sha256:...
# TRANSCRIPTION_IMAGE=registry.example/infosteed-transcription:0.1.0-beta.17@sha256:...
# OLLAMA_IMAGE=ollama/ollama:0.32.3@sha256:...

APP_DOMAIN=infosteed.example.com
# public: Caddy-managed public ACME; internal: Caddy local CA; external:
# externally managed certificate files mounted read-only from TLS_CERT_HOST_PATH.
TLS_MODE=public
# Required only for public mode.
ACME_EMAIL=admin@example.com
TLS_CERT_HOST_PATH=
TLS_CERT_FILE=/certs/fullchain.pem
TLS_KEY_FILE=/certs/key.pem
APP_SOURCE_URL=https://github.com/infosteed/infosteed
EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_OFFICIAL_EXTENSION_ID
SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
TWO_FACTOR_ENABLED=false
TWO_FACTOR_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_BACK_THIS_UP

# Configure these with scripts/configure-ai-services.sh. Each service can be
# managed in this Compose project, external, or off.
LLM_MODE=off
AI_PROVIDER=ollama
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=qwen3-vl:8b-instruct
AI_TIMEOUT_MS=30000
AI_SCRIPT_TIMEOUT_MS=300000
LLM_GPU_DEVICE=0

TRANSCRIPTION_MODE=off
TRANSCRIPTION_PROVIDER=openai-compatible
TRANSCRIPTION_ENDPOINT=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=large-v3-turbo
TRANSCRIPTION_GPU_DEVICE=0
TRANSCRIPTION_TIMEOUT_MS=5400000
TRANSCRIPTION_MAX_UPLOAD_BYTES=25000000

# Remote screenshots downloaded by the one-way Scribe Markdown importer.
SCRIBE_IMPORT_IMAGE_DELAY_MS=750
SCRIBE_IMPORT_IMAGE_MAX_BYTES=20971520
SCRIBE_IMPORT_TOTAL_IMAGE_MAX_BYTES=104857600
SCRIBE_IMPORT_IMAGE_TIMEOUT_MS=30000
HF_HUB_DISABLE_XET=1
HF_TOKEN=

VOICEOVER_MODE=off
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=kokoro
TTS_DEFAULT_VOICE=af_heart
TTS_TIMEOUT_MS=120000
TTS_MAX_RESPONSE_BYTES=25000000

POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_SECRET
POSTGRES_DB=app
STORAGE_MODE=garage
GARAGE_RPC_SECRET=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
S3_ENDPOINT=http://garage:3900
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=app-media
S3_ACCESS_KEY_ID=GK_REPLACE_WITH_32_HEXADECIMAL_CHARACTERS
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SEPARATE_RANDOM_APP_SECRET

# External S3: select STORAGE_MODE=external and supply its endpoint, region, bucket and credentials.
