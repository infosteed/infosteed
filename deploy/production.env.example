# Use ghcr to pull official release images, or build to compile this checkout.
IMAGE_SOURCE=ghcr
RELEASE_VERSION=0.1.0-beta.1
RELEASE_COMMIT=REPLACE_WITH_FULL_COMMIT
LOCAL_IMAGE_TAG=sha-REPLACE_WITH_12_CHARACTER_COMMIT

# Optional full image overrides, including digest-pinned mirrors:
# WEB_IMAGE=registry.example/infosteed-web:0.1.0-beta.1@sha256:...
# API_IMAGE=registry.example/infosteed-api:0.1.0-beta.1@sha256:...
# RENDER_IMAGE=registry.example/infosteed-video-render-worker:0.1.0-beta.1@sha256:...
# TRANSCRIPTION_IMAGE=registry.example/infosteed-transcription:0.1.0-beta.1@sha256:...

APP_DOMAIN=guides.example.com
ACME_EMAIL=admin@example.com
APP_SOURCE_URL=https://github.com/infosteed/infosteed
EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_OFFICIAL_EXTENSION_ID
SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_SECRET
POSTGRES_DB=app
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_ROOT_SECRET
S3_BUCKET=app-media
S3_ACCESS_KEY_ID=app-media-user
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SEPARATE_RANDOM_APP_SECRET
