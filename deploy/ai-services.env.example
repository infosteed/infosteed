# Standalone managed AI services. Copy to ai-services.env and chmod 600.
RELEASE_VERSION=0.1.0-beta.9
COMPOSE_PROFILES=ollama,transcription,voiceover
AI_BIND_ADDRESS=192.168.0.183
AI_ALLOW_CLIENT=192.168.0.156
OLLAMA_INSTALL_MODE=managed
OLLAMA_ENDPOINT=
AI_MODEL=qwen3-vl:8b-instruct
LLM_GPU_DEVICE=0
TRANSCRIPTION_MODEL=large-v3-turbo
TRANSCRIPTION_GPU_DEVICE=0
TRANSCRIPTION_API_KEY=REPLACE_WITH_RANDOM_BEARER_TOKEN
TRANSCRIPTION_MAX_UPLOAD_BYTES=25000000
HF_HUB_DISABLE_XET=1
HF_TOKEN=
