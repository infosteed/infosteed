# Every image value must include both an immutable release tag and sha256 digest.
CADDY_IMAGE=caddy:2.10.2@sha256:REPLACE
WEB_IMAGE=ghcr.io/OWNER/PROJECT-web:0.1.0-beta.1@sha256:REPLACE
API_IMAGE=ghcr.io/OWNER/PROJECT-api:0.1.0-beta.1@sha256:REPLACE
RENDER_IMAGE=ghcr.io/OWNER/PROJECT-video-render-worker:0.1.0-beta.1@sha256:REPLACE
POSTGRES_IMAGE=postgres:16-alpine@sha256:REPLACE
MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z@sha256:REPLACE
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-07-21T05-28-08Z@sha256:REPLACE
TRANSCRIPTION_IMAGE=ghcr.io/OWNER/PROJECT-transcription:0.1.0-beta.1@sha256:REPLACE
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.2.4@sha256:REPLACE

APP_DOMAIN=guides.example.com
ACME_EMAIL=admin@example.com
APP_SOURCE_URL=https://github.com/OWNER/PROJECT
RELEASE_VERSION=0.1.0-beta.1
RELEASE_COMMIT=REPLACE_WITH_FULL_COMMIT
EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_OFFICIAL_EXTENSION_ID
SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_SECRET
POSTGRES_DB=app
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_ROOT_SECRET
S3_BUCKET=app-media
S3_ACCESS_KEY_ID=app-media-user
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SEPARATE_RANDOM_APP_SECRET
